{
  "id": "com.stamper.transitionspike",
  "name": "Transition Stamper",
  "version": "0.0.1",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": { "clipboard": "readAndWrite", "localFileSystem": "fullAccess" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "stamperPanel",
      "label": { "default": "Transition Stamper" },
      "minimumSize": { "width": 280, "height": 300 },
      "preferredDockedSize": { "width": 320, "height": 480 }
    }
  ]
}
